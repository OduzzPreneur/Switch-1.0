# ==============================================================================
# SWITCH 1.0 PORTAL CONFIGURATION
# ==============================================================================

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Paystack Payment Gateway (₦5,000 Token Processing)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administration & Security
ADMIN_EMAIL=admin@switch.ng
ADMIN_PASSKEY=your_secure_admin_passkey
SESSION_SECRET=your_32_byte_random_hex_session_secret

